{
  "name": "reaper-ios",
  "version": "0.1.0",
  "private": true,
  "description": "Reaper for iOS — serverless, end-to-end encrypted chat over Tor.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:plugins": "tsc -p plugins/keepalive && tsc -p plugins/socket && tsc -p plugins/tor",
    "build": "npm run build:plugins && vite build",
    "sync": "npm run build && cap sync ios",
    "shim:test": "node scripts/shim.mjs",
    "ios:build": "node scripts/remote-build.mjs",
    "ios:status": "node scripts/remote-build.mjs --status"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@reaper/keepalive": "file:plugins/keepalive",
    "@reaper/socket": "file:plugins/socket",
    "@reaper/tor": "file:plugins/tor",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "brotli-wasm": "^3.0.1",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
