{
  "name": "reaper-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reaper in a browser, over a Tor relay you host.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "relay": "node server/relay.mjs",
    "serve": "npm run build && node server/relay.mjs",
    "serve:tls": "npm run build && PORT=443 REAPER_TLS_CERT=cert/cert.cer REAPER_TLS_KEY=cert/key.key node server/relay.mjs"
  },
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "brotli-wasm": "^3.0.1",
    "buffer": "^6.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
