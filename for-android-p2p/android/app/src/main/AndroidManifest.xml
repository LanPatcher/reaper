<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:extractNativeLibs="true">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera. Two uses, both requested only at the moment they happen:
           - pairing two devices by scanning the QR the desktop shows
             (@reaper/scanner asks for it through Capacitor before opening);
           - the camera in a video call, where getUserMedia runs inside the
             WebView and Capacitor's own WebChromeClient requests it.
         Neither is asked for at launch, and required="false" keeps the app
         installable on a device with no camera. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Microphone, for calls. Voice and video calls both open a mic track
         with getUserMedia in the WebView; without RECORD_AUDIO in the manifest
         Capacitor's WebChromeClient auto-denies the request and the call comes
         up with no audio (or fails to start). MODIFY_AUDIO_SETTINGS lets it
         route audio to the earpiece/speaker for a call rather than media
         playback — Capacitor requests it alongside RECORD_AUDIO for audio
         capture. required="false" so a device without a mic still installs. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
